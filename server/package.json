{
  "name": "mm-padel-academy-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/seed.js",
    "migrate": "knex --knexfile src/db/knexfile.js migrate:latest",
    "migrate:make": "knex --knexfile src/db/knexfile.js migrate:make",
    "migrate:rollback": "knex --knexfile src/db/knexfile.js migrate:rollback",
    "db:load": "node ../../scripts/migrate-json-to-mysql.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "nanoid": "^5.0.7",
    "xlsx": "^0.18.5",
    "exceljs": "^4.4.0"
  }
}
